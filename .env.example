TMDB_KEY="..."
TMDB_READ_ACCESS="..."
POSTGRES_URL="postgresql://..."
POSTGRES_DATA_PATH="path to your folder where you want to put postgres data"
MEDIA_PATH="path to your media files"
MINIO_PATH="path to your minio folder"
MINIO_ROOT_USER="root username for minio"
MINIO_ROOT_PASSWORD="root password for minio"
S3_ENDPOINT=http://minio:9000
S3_IMAGES_BUCKET=tmdb-images
S3_PUBLIC_BASE_URL=http://localhost:9000

# Shared secret for /api/admin/export and /api/admin/restore.
# Leave unset to disable admin endpoints. Send as X-Admin-Token header.
ADMIN_TOKEN="generate_a_long_random_string_here"